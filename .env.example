# NAEYA CI — exemple de configuration
# Copier ce fichier en .env et renseigner les valeurs réelles (jamais dans Git).

# Signature des sessions JWT (obligatoire en production, 32 octets minimum)
SESSION_SECRET=

# Adresse e-mail du compte administrateur initial
OWNER_EMAIL=

# Base de données PostgreSQL (Supabase)
# Utiliser l'URL du pooler (port 6543) et conserver sslmode=require.
DATABASE_URL=

# Stockage privé des pièces justificatives (Supabase Storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=naeya-documents
